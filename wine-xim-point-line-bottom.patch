+/* 应用只给光标点（CFS_POINT）时拿不到行高，退回到窗口当前字体的行高。 */
+static int get_window_font_height( HWND hwnd )
+{
+    TEXTMETRICW metrics;
+    HDC hdc;
+    int height = 0;
+
+    if (!(hdc = NtUserGetDC( hwnd ))) return 0;
+    if (NtGdiGetTextMetricsW( hdc, &metrics, 0 )) height = metrics.tmHeight;
+    NtUserReleaseDC( hwnd, hdc );
+    TRACE( "hwnd %p: window font height %d\n", hwnd, height );
+    return height;
+}
